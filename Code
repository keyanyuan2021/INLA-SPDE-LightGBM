    all_preds[, i] <- predict(
      model_i,
      X_new,
      num_iteration = best_iter_i
    )
  }
  
  list(
    mean = rowMeans(all_preds, na.rm = TRUE),
    sd = apply(all_preds, 1, sd, na.rm = TRUE),
    all_predictions = all_preds
  )
}

