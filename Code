library(viridis)

plot_feature_importance_multi_viridis <- function(model, top_n = 21) {
  # 获取三种类型的重要性
  importance_gain <- lgb.importance(model, percentage = TRUE)
  importance_split <- lgb.importance(model, percentage = FALSE)
  importance_cover <- lgb.importance(model, percentage = FALSE)
  
  if (is.null(importance_gain) || nrow(importance_gain) == 0) {
    warning("无法获取特征重要性")
    return(NULL)
  }
  
  # 合并数据
  importance_all <- importance_gain %>%
    select(Feature, Gain) %>%
    left_join(importance_split %>% select(Feature, Frequency), by = "Feature") %>%
    left_join(importance_cover %>% select(Feature, Cover), by = "Feature")
  
  # 归一化
  importance_all <- importance_all %>%
    mutate(
      Gain_norm = Gain / max(Gain, na.rm = TRUE),
      Frequency_norm = Frequency / max(Frequency, na.rm = TRUE),
      Cover_norm = Cover / max(Cover, na.rm = TRUE)
    )
  
  # 选择前N个特征（基于Gain）
  importance_top <- head(importance_all[order(-importance_all$Gain), ], top_n)
  
  # 转换为长格式
  importance_long <- importance_top %>%
    select(Feature, Gain_norm, Frequency_norm, Cover_norm) %>%
    pivot_longer(
      cols = c(Gain_norm, Frequency_norm, Cover_norm),
      names_to = "Importance_Type",
      values_to = "Value"
    ) %>%
    mutate(
      Importance_Type = factor(Importance_Type,
                               levels = c("Gain_norm", "Frequency_norm", "Cover_norm"),
                               labels = c("增益 (Gain)", "分裂次数 (Frequency)", "覆盖度 (Cover)"))
    )
  
  # 使用viridis配色
  p <- ggplot(importance_long, aes(x = reorder(Feature, Value), y = Value, fill = Importance_Type)) +
    geom_bar(stat = "identity", position = "dodge", alpha = 0.9, width = 0.7) +
    coord_flip() +
    scale_fill_viridis(discrete = TRUE, option = "D", name = "重要性类型") +
    labs(
      title = paste0("多类型特征重要性对比 (Top ", top_n, ")"),
      x = "特征",
      y = "归一化重要性"
    ) +
    theme_minimal() +
    theme(
      plot.title = element_text(hjust = 0.5, size = 16, face = "bold"),
      axis.text.y = element_text(size = 9),
      axis.text.x = element_text(size = 8),
      axis.title = element_text(size = 11, face = "bold"),
      legend.position = "bottom",
      legend.title = element_text(size = 10, face = "bold"),
      legend.text = element_text(size = 9),
      # 添加X轴和Y轴线
      axis.line = element_line(color = "black", size = 0.6),
      axis.ticks = element_line(color = "black", size = 0.5),
      axis.ticks.length = unit(0.2, "cm"),
      # 调整网格线
      panel.grid.major = element_line(color = "gray90", size = 0.3),
      panel.grid.minor = element_blank()
    )
  
  return(p)
}

