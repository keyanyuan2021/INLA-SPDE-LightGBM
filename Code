# 2. 创建SHAP解释器函数
create_shap_explainer <- function(model, X_train, X_explain = NULL, n_samples = 100) {
  cat("创建SHAP解释器...\n")
  
  # 如果未指定解释数据，使用训练数据
  if (is.null(X_explain)) {
    X_explain <- X_train
  }
  
  # 采样以减少计算量
  if (nrow(X_explain) > n_samples) {
    set.seed(123)
    sample_idx <- sample(1:nrow(X_explain), n_samples)
    X_explain <- X_explain[sample_idx, ]
    cat("采样", n_samples, "个样本进行SHAP分析\n")
  }
  
  # 将数据转换为矩阵格式
  X_train_mat <- as.matrix(X_train)
  X_explain_mat <- as.matrix(X_explain)
  
  # 方法1: 使用shapviz包
  tryCatch({
    cat("尝试使用shapviz包...\n")
    shap_values <- shapviz(model, X_pred = X_explain_mat)
    return(list(method = "shapviz", shap_obj = shap_values))
  }, error = function(e) {
    cat("shapviz失败:", e$message, "\n")
    
    # 方法2: 使用fastshap包
    tryCatch({
      cat("尝试使用fastshap包...\n")
      
      # 定义预测函数
      pred_wrapper <- function(object, newdata) {
        predict(object, as.matrix(newdata))
      }
      
      # 计算SHAP值
      shap_values_fast <- fastshap::explain(
        model,
        X = as.data.frame(X_train_mat),
        nsim = 30,  # 减少模拟次数以加快计算
        pred_wrapper = pred_wrapper,
        newdata = as.data.frame(X_explain_mat)
      )
      
      # 确保SHAP对象有正确的属性
      attr(shap_values_fast, "X") <- as.data.frame(X_explain_mat)
      
      return(list(method = "fastshap", shap_obj = shap_values_fast))
    }, error = function(e2) {
      cat("fastshap失败:", e2$message, "\n")
      
      # 方法3: 近似SHAP值
      cat("使用近似方法计算SHAP值...\n")
      return(calculate_approximate_shap(model, X_train_mat, X_explain_mat))
    })
  })
}

# 3. SHAP摘要图函数
plot_shap_summary <- function(shap_result, top_n = 15) {
  if (is.null(shap_result) || is.null(shap_result$shap_obj)) {
    warning("SHAP对象为空")
    return(NULL)
  }
  
  shap_obj <- shap_result$shap_obj
  method <- shap_result$method
  
  cat("使用", method, "方法绘制SHAP摘要图\n")
  
  if (method == "fastshap") {
    # fastshap对象处理
    shap_df <- as.data.frame(shap_obj)
    
    if (ncol(shap_df) == 0) {
      warning("SHAP数据框为空")
      return(NULL)
    }
    
    # 计算平均绝对SHAP值
    mean_abs_shap <- colMeans(abs(shap_df), na.rm = TRUE)
    
    if (length(mean_abs_shap) == 0) {
      warning("无法计算平均绝对SHAP值")
      return(NULL)
    }
    
    # 按重要性排序，选择前top_n个特征
    if (length(mean_abs_shap) < top_n) {
      top_n <- length(mean_abs_shap)
    }
    top_features <- names(sort(mean_abs_shap, decreasing = TRUE))[1:top_n]
    
    # 获取特征值
    if (!is.null(attr(shap_obj, "X"))) {
      X_df <- as.data.frame(attr(shap_obj, "X"))
    } else {
      warning("无法获取特征值")
      return(NULL)
    }
    
    # 确保我们有共同的特征
    common_features <- intersect(top_features, colnames(X_df))
    if (length(common_features) == 0) {
      warning("没有共同的特征")
      return(NULL)
    }
    
    # 准备绘图数据
    plot_data_list <- list()
    for (i in seq_along(common_features)) {
      feature <- common_features[i]
      temp_data <- data.frame(
        Feature = feature,
        SHAP_Value = shap_df[[feature]],
        Feature_Value = X_df[[feature]]
      )
      plot_data_list[[i]] <- temp_data
    }
    
    if (length(plot_data_list) == 0) {
      warning("没有找到有效的特征数据")
      return(NULL)
    }
    
    plot_data <- do.call(rbind, plot_data_list)
    
    # 绘制蜂群图
    p <- ggplot(plot_data, aes(x = SHAP_Value, y = Feature, 
                               color = Feature_Value)) +
      geom_point(alpha = 0.6, size = 1.5, position = position_jitter(width = 0, height = 0.2)) +
      scale_color_gradient2(low = "blue", mid = "white", high = "red", 
                            midpoint = median(plot_data$Feature_Value, na.rm = TRUE)) +
      labs(
        title = paste("SHAP摘要图 (Top", length(unique(plot_data$Feature)), "特征)"),
        x = "SHAP值",
        y = "特征",
        color = "特征值"
      ) +
      theme_minimal() +
      theme(
        plot.title = element_text(hjust = 0.5, size = 16, face = "bold"),
        axis.text.y = element_text(size = 10)
      ) +
      scale_y_discrete(limits = rev(sort(unique(plot_data$Feature))))
    
    return(p)
  } else if (method == "shapviz") {
    # 使用shapviz绘图
    p <- sv_importance(shap_obj, kind = "bee", max_display = top_n) +
      labs(title = paste("SHAP摘要图 (Top", top_n, "特征)")) +
      theme(
        plot.title = element_text(hjust = 0.5, size = 16, face = "bold"),
        axis.text.y = element_text(size = 10)
      )
    return(p)
  } else {
    warning("当前方法不支持图形绘制")
    return(NULL)
  }
}

