      Intercept = rep(1, nrow(all_data)),
      log_MHRR = all_data$log_MHRR,
      PM = all_data[["PM2.5"]],
      Eth = all_data$Eth,
      Over65por = all_data$Over65por,
      Edu = all_data$Edu,
      Room = all_data$Room,
      LiverB = all_data$LiverB,
      PerDI = all_data$PerDI,
      HEGDP = all_data$HEGDP,
      PHE = all_data$PHE,
      SSQ_id = all_data$SSQ_id,
      ShengID_id = all_data$ShengID_id,
      Order_id = all_data$Order_id,
      time_id = all_data$time_id
    ),
    w = s.index
  )
)

stk.p <- inla.stack(
  tag = "pred",
  data = list(y = NA),
  A = list(1, Ap),
  effects = list(
    data.frame(
      Intercept = rep(1, nrow(pred_grid)),
      log_MHRR = log(pred_grid$MHRR1),
      PM = pred_grid[["PM2.5"]],
      Eth = pred_grid$Eth,
      Over65por = pred_grid$Over65por,
      Edu = pred_grid$Edu,
      Room = pred_grid$Room,
      LiverB = pred_grid$LiverB,
      PerDI = pred_grid$PerDI,
      HEGDP = pred_grid$HEGDP,
      PHE = pred_grid$PHE,
      SSQ_id = pred_grid$SSQ_id,
      ShengID_id = pred_grid$ShengID_id,
      Order_id = pred_grid$Order_id,
      time_id = rep(target_time_id, nrow(pred_grid))
    ),
    w = s.index
  )
)

stk.full <- inla.stack(stk.e, stk.p)

formulay <- y ~ -1 + Intercept +
  offset(log_MHRR) +
  PM + Eth + Over65por + Edu + Room + LiverB + PerDI + HEGDP + PHE +
  f(SSQ_id, model = "iid") +
  f(ShengID_id, model = "iid") +
  f(Order_id, model = "iid") +
  f(
    time_id,
    model = "rw1",
    hyper = list(
      prec = list(prior = "pc.prec", param = c(1, 0.01))
    )
  ) +
  f(w, model = spde)

Mod_Pointy <- inla(
  formulay,
  data = inla.stack.data(stk.full),
  family = "poisson",
  control.fixed = list(
    mean.intercept = 0,
    prec.intercept = 0.01,
    mean = 0,
    prec = 0.01
  ),
  control.predictor = list(
    A = inla.stack.A(stk.full),
    compute = TRUE,
    link = 1
  ),
  control.compute = list(
    dic = TRUE,
    waic = TRUE,
    cpo = TRUE
  ),
  control.inla = list(int.strategy = "eb"),
  verbose = TRUE
)

summary(Mod_Pointy)

idx_2020 <- inla.stack.index(
  stack = stk.full,
  tag = "pred"
)$data

prev_mean <- Mod_Pointy$summary.fitted.values[idx_2020, "mean"]
prev_sd   <- Mod_Pointy$summary.fitted.values[idx_2020, "sd"]
prev_ll   <- Mod_Pointy$summary.fitted.values[idx_2020, "0.025quant"]
prev_ul   <- Mod_Pointy$summary.fitted.values[idx_2020, "0.975quant"]

pred_data <- data.frame(
  x = pred_grid$x,
  y = pred_grid$y,
  year = target_year,
  PM2.5 = pred_grid[["PM2.5"]],
  Eth = pred_grid$Eth,
  Over65por = pred_grid$Over65por,
  Edu = pred_grid$Edu,
  Room = pred_grid$Room,
  LiverB = pred_grid$LiverB,
  PerDI = pred_grid$PerDI,
  HEGDP = pred_grid$HEGDP,
  PHE = pred_grid$PHE,
  SSQ = pred_grid$SSQ,
  ShengID = pred_grid$ShengID,
  Order = pred_grid$Order,
  SSQ_id = pred_grid$SSQ_id,
  ShengID_id = pred_grid$ShengID_id,
  Order_id = pred_grid$Order_id,
  MHRR1 = pred_grid$MHRR1
)

pred_data$inla_fitted <- prev_mean
pred_data$inla_sd <- prev_sd
pred_data$inla_lower <- prev_ll
pred_data$inla_upper <- prev_ul

# =========================
# 2020 LightGBM 特征
# =========================

time_effects_summary_pred <- Mod_Pointy$summary.random$time_id
time_effects_pred <- time_effects_summary_pred$mean
time_trend_pred <- c(diff(time_effects_pred), tail(diff(time_effects_pred), 1))

pred_data$time_idx <- target_time_id
pred_data$time_effect_mean <- time_effects_summary_pred$mean[pred_data$time_idx]
pred_data$time_effect_sd <- time_effects_summary_pred$sd[pred_data$time_idx]
pred_data$time_effect_025 <- time_effects_summary_pred$`0.025quant`[pred_data$time_idx]
pred_data$time_effect_975 <- time_effects_summary_pred$`0.975quant`[pred_data$time_idx]
pred_data$time_effect_ci_width <- pred_data$time_effect_975 - pred_data$time_effect_025
pred_data$time_trend <- time_trend_pred[pred_data$time_idx]
pred_data$time_position <- (pred_data$time_idx - 1) / (max(all_data$time_id, na.rm = TRUE) - 1)

ssq_effects_pred <- Mod_Pointy$summary.random$SSQ_id
sheng_effects_pred <- Mod_Pointy$summary.random$ShengID_id
order_effects_pred <- Mod_Pointy$summary.random$Order_id

pred_data$ssq_effect_mean <- ssq_effects_pred$mean[match(pred_data$SSQ_id, ssq_effects_pred$ID)]
pred_data$sheng_effect_mean <- sheng_effects_pred$mean[match(pred_data$ShengID_id, sheng_effects_pred$ID)]
pred_data$order_effect_mean <- order_effects_pred$mean[match(pred_data$Order_id, order_effects_pred$ID)]

pred_data$ssq_effect_sd <- ssq_effects_pred$sd[match(pred_data$SSQ_id, ssq_effects_pred$ID)]
pred_data$sheng_effect_sd <- sheng_effects_pred$sd[match(pred_data$ShengID_id, sheng_effects_pred$ID)]
pred_data$order_effect_sd <- order_effects_pred$sd[match(pred_data$Order_id, order_effects_pred$ID)]

for (v in required_features) {
  pred_data[[v]] <- fill_na_with_mean(pred_data[[v]])
}

X_pred <- as.matrix(pred_data[, required_features])

best_iter <- lgb_model$best_iter
if (is.null(best_iter)) best_iter <- lgb_model$current_iter()

pred_data$LightGBM_Residual_Pred <- predict(
  lgb_model,
  X_pred,
  num_iteration = best_iter
)

ens_2020 <- ensemble_predictions(X_pred, cv_results)

pred_data$LightGBM_Residual_Mean <- ens_2020$mean
pred_data$LightGBM_Residual_SD <- ens_2020$sd
pred_data$LightGBM_Residual_Lower <- ens_2020$mean - 1.96 * ens_2020$sd
pred_data$LightGBM_Residual_Upper <- ens_2020$mean + 1.96 * ens_2020$sd

pred_data$Final_Pred <- pred_data$inla_fitted + pred_data$LightGBM_Residual_Mean
pred_data$Final_SD <- sqrt(pred_data$inla_sd^2 + pred_data$LightGBM_Residual_SD^2)
pred_data$Final_Lower <- pred_data$Final_Pred - 1.96 * pred_data$Final_SD
pred_data$Final_Upper <- pred_data$Final_Pred + 1.96 * pred_data$Final_SD

final_results_2020 <- pred_data %>%
  select(
