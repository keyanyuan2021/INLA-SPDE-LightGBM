# 1. 累积重要性曲线
plot_cumulative_curve <- function(model, 
                                  top_n = 25, 
                                  cumulative_threshold = 0.95,
                                  title = "特征累积重要性曲线") {
  
  # 获取特征重要性
  importance <- lgb.importance(model, percentage = TRUE)
  
  if (is.null(importance) || nrow(importance) == 0) {
    warning("无法获取特征重要性")
    return(NULL)
  }
  
  # 按重要性降序排序
  importance_ordered <- importance[order(-importance$Gain), ]
  importance_ordered$Cumulative_Gain <- cumsum(importance_ordered$Gain)
  importance_ordered$Feature_Number <- 1:nrow(importance_ordered)
  importance_ordered$Feature_Label <- ifelse(
    1:nrow(importance_ordered) <= 5,
    as.character(importance_ordered$Feature),
    ""
  )
  
  # 确定达到累积阈值所需的最少特征数
  threshold_index <- which(importance_ordered$Cumulative_Gain >= cumulative_threshold)[1]
  threshold_features <- importance_ordered$Feature[1:threshold_index]
  threshold_cumulative <- importance_ordered$Cumulative_Gain[threshold_index]
  
  # 限制显示的特征数
  if (!is.null(top_n) && top_n < nrow(importance_ordered)) {
    plot_data <- head(importance_ordered, top_n)
  } else {
    plot_data <- importance_ordered
  }
  
  # 创建图形
  p <- ggplot(plot_data, aes(x = Feature_Number, y = Cumulative_Gain)) +
    geom_line(color = "steelblue", linewidth = 1.5) +
    geom_point(color = "steelblue", size = 2.5, shape = 19) +
    geom_area(fill = "steelblue", alpha = 0.1) +
    
    # 添加阈值线
    geom_hline(yintercept = cumulative_threshold, 
               linetype = "dashed", color = "#E74C3C", linewidth = 1) +
    geom_vline(xintercept = threshold_index, 
               linetype = "dashed", color = "#F39C12", linewidth = 1) +
    
    # 标记前5个特征
    geom_text(aes(label = Feature_Label), 
              vjust = -0.8, hjust = 0.5, 
              size = 3.5, color = "#2C3E50", fontface = "bold") +
    
    # 标记阈值点
    geom_point(data = plot_data[threshold_index, ], 
               aes(x = Feature_Number, y = Cumulative_Gain), 
               color = "#E74C3C", size = 4, shape = 17) +
    
    # 坐标轴设置
    scale_x_continuous(
      breaks = function(x) {
        seq(1, max(x), by = max(1, floor(max(x)/10)))
      },
      expand = expansion(mult = c(0.02, 0.05))
    ) +
    scale_y_continuous(
      labels = percent_format(accuracy = 1),
      limits = c(0, 1.05),
      breaks = seq(0, 1, by = 0.2),
      expand = expansion(mult = c(0, 0.05))
    ) +
    
    # 标签和标题
    labs(
      title = title,
      subtitle = sprintf("达到%.0f%%累积重要性需要前%d个特征\n前5个特征: %s", 
                         cumulative_threshold * 100, 
                         threshold_index,
                         paste(head(threshold_features, 5), collapse = ", ")),
      x = "特征数量 (按重要性降序排列)",
      y = "累积重要性"
    ) +
    
    # 主题设置
    theme_minimal(base_size = 12) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold", size = 16, 
                                margin = margin(b = 10)),
      plot.subtitle = element_text(hjust = 0.5, size = 11, color = "gray40",
                                   margin = margin(b = 15)),
      axis.title = element_text(size = 13, face = "bold"),
      axis.text = element_text(size = 10, color = "black"),
      axis.line = element_line(color = "black", linewidth = 0.5),
      panel.grid.major = element_line(color = "gray90", linewidth = 0.3),
      panel.grid.minor = element_blank(),
      plot.background = element_rect(fill = "white", color = NA),
      panel.background = element_rect(fill = "white", color = NA),
      plot.margin = margin(20, 20, 20, 20)
    ) +
    
    # 添加阈值说明
    annotate("text", 
             x = threshold_index, 
             y = cumulative_threshold + 0.05,
             label = sprintf("阈值点\n(%d个特征, %.1f%%)", 
                             threshold_index, 
                             threshold_cumulative * 100),
             color = "#E74C3C", 
             size = 4.5, 
             fontface = "bold",
             hjust = 0.5) +
    
    # 添加参考线标签
    annotate("text", 
             x = max(plot_data$Feature_Number) * 0.8, 
             y = cumulative_threshold - 0.02,
             label = sprintf("%.0f%% 累积重要性阈值", cumulative_threshold * 100),
             color = "#E74C3C", 
             size = 4, 
             fontface = "italic")
  
  return(p)
}
