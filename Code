# 帕累托图函数
plot_pareto_chart <- function(model, 
                              top_n = 20, 
                              cumulative_threshold = 0.95,
                              title = "特征重要性帕累托图") {
  
  # 获取特征重要性
  importance <- lgb.importance(model, percentage = TRUE)
  
  if (is.null(importance) || nrow(importance) == 0) {
    warning("无法获取特征重要性")
    return(NULL)
  }
  
  # 按重要性降序排序
  importance_ordered <- importance[order(-importance$Gain), ]
  importance_ordered$Cumulative_Gain <- cumsum(importance_ordered$Gain)
  importance_ordered$Cumulative_Percent <- importance_ordered$Cumulative_Gain * 100
  importance_ordered$Percentage <- importance_ordered$Gain * 100
  
  # 限制显示的特征数
  if (!is.null(top_n) && top_n < nrow(importance_ordered)) {
    plot_data <- head(importance_ordered, top_n)
  } else {
    plot_data <- importance_ordered
  }
  
  # 确定达到累积阈值所需的最少特征数
  threshold_index <- which(plot_data$Cumulative_Gain >= cumulative_threshold)[1]
  
  # 创建图形
  p <- ggplot(plot_data, aes(x = reorder(Feature, -Gain))) +
    
    # 柱状图 - 单个特征重要性
    geom_bar(aes(y = Percentage), 
             stat = "identity", 
             fill = "#3498DB", 
             alpha = 0.8,
             width = 0.7) +
    
    # 折线图 - 累积重要性
    geom_line(aes(y = Cumulative_Percent, group = 1), 
              color = "#E74C3C", 
              linewidth = 1.5) +
    geom_point(aes(y = Cumulative_Percent), 
               color = "#E74C3C", 
               size = 3, 
               shape = 19) +
    
    # 阈值线
    geom_hline(yintercept = cumulative_threshold * 100, 
               linetype = "dashed", 
               color = "#2ECC71", 
               linewidth = 1) +
    
    # 阈值标记
    geom_vline(xintercept = threshold_index + 0.5, 
               linetype = "dashed", 
               color = "#F39C12", 
               linewidth = 0.8) +
    
    # 双Y轴
    scale_y_continuous(
      name = "单个特征重要性 (%)",
      sec.axis = sec_axis(~./100, 
                          name = "累积重要性", 
                          labels = percent_format()),
      limits = c(0, 105),
      expand = expansion(mult = c(0, 0.05))
    ) +
    
    # 标签和标题
    labs(
      title = title,
      subtitle = "柱状图: 单个特征重要性 | 折线图: 累积重要性",
      x = "特征 (按重要性降序排列)"
    ) +
    
    # 主题设置
    theme_minimal(base_size = 12) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold", size = 16, 
                                margin = margin(b = 10)),
      plot.subtitle = element_text(hjust = 0.5, size = 11, color = "gray40",
                                   margin = margin(b = 15)),
      axis.title.y.left = element_text(color = "#3498DB", size = 13, face = "bold",
                                       margin = margin(r = 10)),
      axis.title.y.right = element_text(color = "#E74C3C", size = 13, face = "bold",
                                        margin = margin(l = 10)),
      axis.text.x = element_text(angle = 45, hjust = 1, size = 10, 
                                 color = "black", face = "plain"),
      axis.text.y.left = element_text(color = "#3498DB"),
      axis.text.y.right = element_text(color = "#E74C3C"),
      axis.line.x = element_line(color = "black", linewidth = 0.5),
      panel.grid.major = element_line(color = "gray90", linewidth = 0.3),
      panel.grid.minor = element_blank(),
      plot.background = element_rect(fill = "white", color = NA),
      panel.background = element_rect(fill = "white", color = NA),
      plot.margin = margin(20, 20, 20, 20)
    ) +
    
    # 添加阈值说明
    annotate("text", 
             x = threshold_index, 
             y = cumulative_threshold * 100 + 5,
             label = sprintf("%.0f%% 阈值\n(前%d个特征)", 
                             cumulative_threshold * 100, 
                             threshold_index),
             color = "#2ECC71", 
             size = 4, 
             fontface = "bold",
             hjust = 0.5)
  
  return(p)
}
