#滑动窗口交叉验证
Point_Data <- Point_Data[order(Point_Data$year), ]
window_size <- 10
unique_years <- sort(unique(Point_Data$year))
n_years <- length(unique_years)
min_train_years <- window_size  # 至少需要window_size年的数据训练
# 存储交叉验证结果
cv_results <- list()           # 预测结果
cv_test <- list()              # 实际值
cv_rmse <- numeric()           # RMSE
cv_me <- numeric()             # ME
cv_mse <- numeric()            # MSE
cv_mae <- numeric()            # MAE
cv_r2 <- numeric()             # R²
cv_years <- numeric()          # 预测年份
cv_predictions <- list()       # 详细预测数据
cv_models <- list()            # 存储每个窗口的模型

# 滑动窗口交叉验证循环
fold_counter <- 0
for (i in 1:(n_years - window_size)) {
  # 定义训练年和测试年
  train_years <- unique_years[i:(i + window_size - 1)]
  test_year <- unique_years[i + window_size]
  train_data <- Point_Data[Point_Data$year %in% train_years, ]
  test_data <- Point_Data[Point_Data$year == test_year, ]
  
  # 检查数据量
  if (nrow(train_data) < 20 || nrow(test_data) < 5) {
    cat("数据量不足，跳过此窗口（训练集:", nrow(train_data), 
        "测试集:", nrow(test_data), "）\n")
    next
  }
  fold_counter <- fold_counter + 1
  start_time <- Sys.time()
  
  tryCatch({
    # 设置控制参数以减少计算时间
    model_control <- list(
      adapt_delta = 0.95,
      max_treedepth = 12
    )
    
    # 训练模型
    model1 <- brm(
      formula = QIcase ~ offset(log(MHRR1)) + 
        Temp + Eth + Over65por + Edu + Room + House + 
        PGDP + PerDI + PMeat + 
        s(Lon, Lat, k = 10) +  # 减少平滑项复杂度以加快计算
        (1 | SSQ) + (1 | ShengID) + (1 | year),
      data = train_data,
      family = negbinomial(),
      chains = 3,  # 减少链数以加快计算
      cores = 3,
      iter = 2000,  # 减少迭代次数
      warmup = 1000,
      control = model_control,
      seed = 123 + i,  # 设置不同的种子
      silent = 2,  # 减少输出
      refresh = 0
    )
    
    end_time <- Sys.time()
    training_time <- round(difftime(end_time, start_time, units = "mins"), 1)
    
    # 检查模型收敛
    rhat_values <- rhat(model1)
    if (any(rhat_values > 1.1, na.rm = TRUE)) {
      cat("警告: 部分参数Rhat > 1.1，模型可能未完全收敛\n")
    } else {
      cat("模型收敛良好 (所有Rhat < 1.1)\n")
    }
    
    # 准备预测数据
    new_data <- data.frame(
      MHRR1 = test_data$MHRR1,
      Temp = test_data$Temp,
      Eth = test_data$Eth,
      Over65por = test_data$Over65por,
      Edu = test_data$Edu,
      Room = test_data$Room,
      House = test_data$House,
      PGDP = test_data$PGDP,
      PerDI = test_data$PerDI,
      PMeat = test_data$PMeat,
      SSQ = test_data$SSQ,
      ShengID = test_data$ShengID,
      year = test_data$year,
      Lon = test_data$Lon,
      Lat = test_data$Lat
    )
    
    # 进行预测
    predictions <- predict(
      model1, 
      newdata = new_data, 
      re_formula = NA,  # 不包含随机效应
      probs = c(0.025, 0.975)  # 获取95%置信区间
    )
    
    predictions_df <- as.data.frame(predictions)
    
    # 计算发病率（考虑offset）
    predicted_incidence <- predictions_df$Estimate / test_data$MHRR1
    true_incidence <- test_data$QInc
    
    # 计算评估指标
    rmse_val <- sqrt(mean((true_incidence - predicted_incidence)^2, na.rm = TRUE))
    me_val <- mean(predicted_incidence - true_incidence, na.rm = TRUE)
    mse_val <- mean((true_incidence - predicted_incidence)^2, na.rm = TRUE)
    mae_val <- mean(abs(true_incidence - predicted_incidence), na.rm = TRUE)
    
    # 计算R²
    ss_total <- sum((true_incidence - mean(true_incidence))^2, na.rm = TRUE)
    ss_residual <- sum((true_incidence - predicted_incidence)^2, na.rm = TRUE)
    r2_val <- 1 - (ss_residual / ss_total)
    
    # 存储结果
    cv_results[[fold_counter]] <- predicted_incidence
    cv_test[[fold_counter]] <- true_incidence
    cv_rmse[fold_counter] <- rmse_val
    cv_me[fold_counter] <- me_val
    cv_mse[fold_counter] <- mse_val
    cv_mae[fold_counter] <- mae_val
    cv_r2[fold_counter] <- r2_val
    cv_years[fold_counter] <- test_year
    
    # 存储模型
    cv_models[[fold_counter]] <- list(
      model = model1,
      train_years = train_years,
      test_year = test_year
    )
  })
  
  # 清理内存
  gc()
}

