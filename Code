# 9. 评价函数

calculate_metrics <- function(true, pred) {
  rmse <- sqrt(mean((true - pred)^2, na.rm = TRUE))
  mse <- mean((true - pred)^2, na.rm = TRUE)
  me <- mean(true - pred, na.rm = TRUE)
  mae <- mean(abs(true - pred), na.rm = TRUE)
  r2 <- 1 - sum((true - pred)^2, na.rm = TRUE) /
    sum((true - mean(true, na.rm = TRUE))^2, na.rm = TRUE)
  
  return(list(
    RMSE = rmse,
    MSE = mse,
    ME = me,
    MAE = mae,
    R2 = r2
  ))
}

