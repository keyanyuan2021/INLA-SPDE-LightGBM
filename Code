ensemble_predictions <- function(X_new, cv_results_list) {
  
  n_models <- length(cv_results_list)
  all_preds <- matrix(NA, nrow = nrow(X_new), ncol = n_models)
  
  for (i in seq_len(n_models)) {
    
    model_i <- cv_results_list[[i]]$model
    best_iter_i <- cv_results_list[[i]]$best_iter
    
    if (is.null(best_iter_i)) {
      best_iter_i <- model_i$best_iter
