create_bbox_center_coords <- function(sf_polygons) {
  if(!inherits(sf_polygons, "sf")) {
    sf_polygons <- st_as_sf(sf_polygons)}
  
  n_areas <- nrow(sf_polygons)
  center_coords <- matrix(NA, nrow = n_areas, ncol = 2)
  
  for(i in 1:n_areas) {
    poly <- sf_polygons[i, ]
    bbox <- st_bbox(poly)
    
    # 直接使用边界框中心
    center_x <- (bbox["xmin"] + bbox["xmax"]) / 2
    center_y <- (bbox["ymin"] + bbox["ymax"]) / 2
    center_coords[i, ] <- c(center_x, center_y)
    
    cat(sprintf("面数据 %d: 边界框 [%.4f, %.4f, %.4f, %.4f] -> 中心点 (%.4f, %.4f)\n", 
                i, bbox["xmin"], bbox["ymin"], bbox["xmax"], bbox["ymax"], 
                center_x, center_y))
  }
  return(center_coords)
}

# 计算面数据的边界框中心坐标
create_simple_center_coords <- function(sf_polygons) {
  if(!inherits(sf_polygons, "sf")) {
    sf_polygons <- st_as_sf(sf_polygons)
  }
  
  n_areas <- nrow(sf_polygons)
  center_coords <- matrix(NA, nrow = n_areas, ncol = 2)
  
  for(i in 1:n_areas) {
    poly <- sf_polygons[i, ]
    bbox <- st_bbox(poly)
    center_x <- (bbox["xmin"] + bbox["xmax"]) / 2
    center_y <- (bbox["ymin"] + bbox["ymax"]) / 2
    center_coords[i, ] <- c(center_x, center_y)
  }
  return(center_coords)
}
